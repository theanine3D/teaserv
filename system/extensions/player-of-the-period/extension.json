{
  "id": "player-of-the-period",
  "name": "Player of the Week",
  "description": "Counts Episode 3 battle wins. When the week or month ends, the leader is announced and receives a Meseta prize.",
  "version": "0.1.0",
  "api_version": 1,
  "entry": "main.lua",
  "permissions": ["commands", "events", "schedule", "storage", "players.store", "boards", "economy.meseta", "chat.announce", "chat.reply"],
  "dependencies": [],
  "settings": {
    "period": {"type": "string", "label": "Period", "default": "week", "max_bytes": 5, "choices": [{"value": "week", "label": "Week (Monday to Sunday)"}, {"value": "month", "label": "Month"}]},
    "prize": {"type": "integer", "label": "Prize (Meseta)", "description": "0: no prize, only the announcement.", "default": 100000, "min": 0, "max": 1000000000},
    "count_com_wins": {"type": "boolean", "label": "Count wins against COMs", "default": false},
    "min_rounds": {"type": "integer", "label": "Fewest rounds for a win to count", "description": "Very short battles do not count.", "default": 3, "min": 0, "max": 1000},
    "max_wins_per_day": {"type": "integer", "label": "Most counted wins per day", "description": "Limits farming.", "default": 20, "min": 1, "max": 100000},
    "title": {"type": "string", "label": "Title", "description": "Name of the award in announcements.", "default": "Player of the Week", "max_bytes": 60}
  }
}
