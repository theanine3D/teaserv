{
  "id": "player-of-the-period",
  "version": "0.1.0",
  "api_version": 1,
  "entry": "main.lua",
  "permissions": ["commands", "events", "schedule", "storage", "players.store", "boards", "economy.meseta", "chat.announce", "chat.reply"],
  "dependencies": [],
  "settings": {
    "period": {"type": "string", "default": "week", "max_bytes": 5},
    "prize": {"type": "integer", "default": 100000, "min": 0, "max": 1000000000},
    "count_com_wins": {"type": "boolean", "default": false},
    "min_rounds": {"type": "integer", "default": 3, "min": 0, "max": 1000},
    "max_wins_per_day": {"type": "integer", "default": 20, "min": 1, "max": 100000},
    "title": {"type": "string", "default": "Player of the Week", "max_bytes": 60}
  }
}
